APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Ouagadougou
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ouaga_chap
DB_USERNAME=root
DB_PASSWORD=changeme_database_password
# Read replica (optionnel) — laisser vide pour utiliser le primaire pour les lectures
DB_READ_HOST=
DB_READ_PORT=3306
DB_READ_USERNAME=
DB_READ_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
# Changer pour 'log' si Reverb n'est pas démarré localement

REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_BROADCAST_DB=3

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# CDN assets (Cloudflare R2 / Hetzner Object Storage) — activer avec FILESYSTEM_DISK=s3
CDN_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# SMS (OTP & Notifications)
# =============================================================================
# Driver: "infobip" (recommended for Africa), "twilio", or "log" for development
SMS_DRIVER=log
SMS_LOG_MESSAGES=false
SMS_LOG_CHANNEL=sms
SMS_DEFAULT_COUNTRY_CODE=+226
SMS_RATE_LIMIT=30

# Infobip Configuration (get from portal.infobip.com)
INFOBIP_API_KEY=your_infobip_api_key
INFOBIP_BASE_URL=https://xxxxx.api.infobip.com
INFOBIP_SMS_SENDER="OUA CHAP"
INFOBIP_SMS_TRANSLITERATION=CENTRAL_EUROPEAN
INFOBIP_SMS_VALIDITY_PERIOD=2880
INFOBIP_SMS_TRACK_DELIVERY=true
INFOBIP_SMS_INTERMEDIATE_REPORTS=false
INFOBIP_SMS_CALLBACK_PREFIX=ouagachap_
INFOBIP_SMS_WEBHOOK_URL=

# Twilio Configuration (get from twilio.com/console)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=+1234567890

# Brevo (Sendinblue) SMS Configuration (get from app.brevo.com)
BREVO_API_KEY=
BREVO_SMS_SENDER=OUAGACHAP

# =============================================================================
# WHATSAPP CLOUD API (Meta Business Platform)
# =============================================================================
# Get from: https://developers.facebook.com > Your App > WhatsApp > API Setup
WHATSAPP_CLOUD_ACCESS_TOKEN=your_whatsapp_cloud_access_token
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v23.0
# Name of the approved OTP template in Meta Business Manager
WHATSAPP_CLOUD_OTP_TEMPLATE_NAME=otp_code
WHATSAPP_CLOUD_OTP_TEMPLATE_LANG=fr
# Enable WhatsApp OTP delivery alongside SMS (false = SMS only)
OTP_WHATSAPP_ENABLED=false
# Random secret token you choose — must match exactly what you enter in:
# Meta App Dashboard > WhatsApp > Configuration > Webhook > Verify Token
WHATSAPP_CLOUD_WEBHOOK_VERIFY_TOKEN=

# =============================================================================
# FIREBASE (Push Notifications & Phone Auth)
# =============================================================================
# Download service account JSON from Firebase Console
# Project Settings > Service Accounts > Generate new private key
FIREBASE_CREDENTIALS=storage/app/firebase/firebase-credentials.json
# Optional: Set project ID if not in credentials file
# FIREBASE_PROJECT=ouaga-chap

# =============================================================================
# GOOGLE MAPS (Admin Panel - Suivi GPS)
# =============================================================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# =============================================================================
# OTP / AUTHENTIFICATION
# =============================================================================
# Driver: "firebase" (recommended), "sms", "log"
AUTH_OTP_DRIVER=firebase

# Fallback to SMS if Firebase fails
AUTH_OTP_FALLBACK_SMS=false

# Demo mode - accepts code 123456 (DO NOT enable in production!)
# ⚠️ Set to true ONLY for local development
AUTH_OTP_DEMO_MODE=false

# Demo code (only if demo_mode=true)
AUTH_OTP_DEMO_CODE=123456

# Max attempts per phone per hour
AUTH_OTP_MAX_ATTEMPTS=5

# =============================================================================
# SANCTUM (API Token Authentication)
# =============================================================================
# Token expiration in minutes (default: 43200 = 30 days)
# Set to null for no expiration (not recommended for production)
SANCTUM_TOKEN_EXPIRATION=43200

# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# OBLIGATOIRE dans tous les environnements — l'app refuse de démarrer si vide.
# Ne jamais laisser vide, ne jamais mettre *.
# Dev  : CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Prod : CORS_ALLOWED_ORIGINS=https://ouagachap.pro,https://admin.ouagachap.pro
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# =============================================================================
# SAPPAY PAYMENTS (Mobile Money - OTP Flow)
# =============================================================================
SAPPAY_CLIENT_ID=your-client-id
SAPPAY_CLIENT_SECRET=your-client-secret
SAPPAY_USERNAME=your-business-email
SAPPAY_PASSWORD=your-business-password
SAPPAY_PUBLIC_URL=https://api.prod.sappay.net/api/public
SAPPAY_CHECKOUT_URL=https://api.prod.sappay.net/api/checkout
SAPPAY_DISBURSE_URL=https://api.prod.sappay.net/api/public
SAPPAY_SANDBOX=true

SAPPAY_WEBHOOK_URL="${APP_URL}/api/v1/sappay/webhook"
# IPs sortantes Sappay — séparées par des virgules (CIDR supporté). Vide = bloqué en production.
SAPPAY_WEBHOOK_ALLOWED_IPS=
# Secret HMAC Sappay — valide la signature X-Sappay-Signature. Vide = bloqué en production.
SAPPAY_WEBHOOK_SECRET=
